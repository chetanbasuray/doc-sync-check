{
  "name": "doc-sync-check",
  "version": "1.6.0",
  "description": "Documentation Drift Detector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "doc-sync-check": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "prepare": "husky",
    "drift-check": "node dist/cli.js tests/fixtures/src --include tests/fixtures/docs/**/*.md",
    "drift-check:strict": "node dist/cli.js tests/fixtures/src --include tests/fixtures/docs/**/*.md --strict --coverage-out coverage/doc-coverage.json --coverage-format json",
    "drift-check:sonar": "node dist/cli.js tests/fixtures/src --include tests/fixtures/docs/**/*.md --coverage-out coverage/sonar-doc-coverage.json --coverage-format sonar",
    "drift-check:cobertura": "node dist/cli.js tests/fixtures/src --include tests/fixtures/docs/**/*.md --coverage-out coverage/cobertura-doc-coverage.xml --coverage-format cobertura",
    "docs:website": "node -e \"console.log('Serve ./website via GitHub Pages or any static host')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetanbasuray/doc-sync-check.git"
  },
  "keywords": [
    "doc",
    "docs",
    "documentation",
    "drift",
    "sync",
    "doc-sync",
    "documentation-drift",
    "typescript",
    "javascript",
    "ast",
    "cli",
    "ci",
    "lint",
    "quality",
    "markdown",
    "jsdoc",
    "tsdoc",
    "jest"
  ],
  "author": "Chetan Basuray",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/chetanbasuray/doc-sync-check/issues"
  },
  "homepage": "https://github.com/chetanbasuray/doc-sync-check#readme",
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@swc/core": "^1.15.32",
    "fs-extra": "^11.3.4",
    "globby": "^16.2.0",
    "meow": "^14.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "semantic-release": "^25.0.3",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.5"
  }
}
